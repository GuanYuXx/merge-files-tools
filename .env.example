# ============================================================
# 複製此檔為 .env，填入真實值後再啟動
#   cp .env.example .env
# ============================================================

# === 必填：共用密碼（部署前請改掉！） ===
APP_PASSWORD=changeme

# === 服務 ===
PORT=8000
HOST=0.0.0.0

# === 上傳限制 ===
MAX_FILE_SIZE_MB=200
MAX_TOTAL_SIZE_MB=1024

# === Session ===
SESSION_TTL_MINUTES=60

# === LibreOffice 平行轉檔數 ===
# NAS DS423+ 2GB RAM 建議 2；升至 6GB 可改 5；本機 i7 可改 20
MAX_PARALLEL_OFFICE=2

# === Session volume 路徑（留空 = ./sessions） ===
SESSIONS_VOLUME=./sessions

# === CORS（留空 = 不啟用 CORS，僅同源） ===
ALLOWED_ORIGINS=
